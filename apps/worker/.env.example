# Copy to .env or .env.local in this directory -- apps/worker auto-loads both
# at startup (src/load-env.ts). Real environment variables (shell exports,
# docker-compose) take precedence over file values.

DATABASE_URL="postgresql://readycheck:readycheck@localhost:5432/readycheck"
REDIS_URL=redis://localhost:6379

# Enables AI narrative generation, AI-written fixes (e.g. TEST-001) and building
# feature slices. Unset = narratives are skipped, template fixes still work,
# and slices fail with a message saying the builder isn't configured.
ANTHROPIC_API_KEY=

# Decrypts the org's stored GitHub token. Must match the API's value.
READYCHECK_ENCRYPTION_KEY=

# Optional overrides (defaults: anthropic / claude-sonnet-5).
AI_PROVIDER=
AI_MODEL=
