# Note: apps/worker does NOT auto-load this file (no dotenv config wired in
# yet) -- these must be real environment variables in whatever process runs
# it. Use `node --env-file=apps/worker/.env apps/worker/dist/main.js`, export
# them in your shell, or set them in docker-compose.yml / your process
# manager. This file exists as a copy-paste reference.

DATABASE_URL="postgresql://readycheck:readycheck@localhost:5432/readycheck"
REDIS_URL=redis://localhost:6379

# Enables AI narrative generation. Unset = narratives are skipped gracefully;
# score/issues are unaffected.
ANTHROPIC_API_KEY=

# Optional overrides (defaults: anthropic / claude-sonnet-5).
AI_PROVIDER=
AI_MODEL=
