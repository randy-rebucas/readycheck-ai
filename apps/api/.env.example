# Note: apps/api does NOT auto-load this file (no dotenv config wired in
# yet) -- these must be real environment variables in whatever process runs
# it. Use `node --env-file=apps/api/.env node apps/api/dist/main.js`, export
# them in your shell, or set them in docker-compose.yml / your process
# manager. This file exists as a copy-paste reference.

DATABASE_URL="postgresql://readycheck:readycheck@localhost:5432/readycheck"
REDIS_URL=redis://localhost:6379
PORT=3001

READYCHECK_API_KEY=

# Must match the dashboard's AUTH_JWT_SECRET exactly.
AUTH_JWT_SECRET=

API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (password reset links). Leave SMTP_HOST unset in local dev:
# reset links are logged to the API console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReadyCheck AI <no-reply@example.com>"
SMTP_SECURE=false
