# Copy to .env or .env.local in this directory -- apps/api auto-loads both at
# startup (src/load-env.ts). Real environment variables (shell exports,
# docker-compose) take precedence over file values.

DATABASE_URL="postgresql://readycheck:readycheck@localhost:5432/readycheck"
REDIS_URL=redis://localhost:6379
PORT=3001

READYCHECK_API_KEY=

# Must match the dashboard's AUTH_JWT_SECRET exactly.
AUTH_JWT_SECRET=

API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (password reset links). Leave SMTP_HOST unset in local dev:
# reset links are logged to the API console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReadyCheck AI <no-reply@example.com>"
SMTP_SECURE=false

# PayPal Subscriptions (Pro plan billing). Unset = /billing/subscribe and
# /billing/webhook fail; Free-tier gating still works without these.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# The PayPal Billing Plan id for the Pro monthly subscription (create it once
# via the PayPal dashboard or API, then paste the plan_id here).
PAYPAL_PRO_PLAN_ID=
# From the webhook's config page in the PayPal developer dashboard -- used to
# verify /billing/webhook requests actually came from PayPal.
PAYPAL_WEBHOOK_ID=
