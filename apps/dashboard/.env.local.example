READYCHECK_API_URL=http://localhost:3001
READYCHECK_API_KEY=

# Must match the API's AUTH_JWT_SECRET exactly.
AUTH_JWT_SECRET=

# Browser-visible: where the login page's provider buttons and OAuth
# callback should point. In docker-compose these should stay on localhost
# (the browser, not the container network, has to reach them).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# PayPal Subscriptions (Pro plan checkout button). Not secret -- the PayPal JS
# SDK and Buttons component need these client-side. Must match apps/api's
# PAYPAL_CLIENT_ID / PAYPAL_PRO_PLAN_ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PRO_PLAN_ID=
