generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  queued
  active
  completed
  failed
  cancelled
}

enum ScanSourceType {
  local
  git
}

enum Severity {
  critical
  high
  medium
  low
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  owner
  admin
  member
}

/// The tenant boundary: scans, notifications and the subscription belong to
/// an organization, never directly to a user. Every user gets a personal org
/// at signup; team orgs are created explicitly.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// The user's own workspace, auto-created at signup. Can't be left or
  /// deleted, and never gets other members.
  personal  Boolean  @default(false)
  createdAt DateTime @default(now())

  memberships   Membership[]
  scans         Scan[]
  notifications Notification[]
  subscription  Subscription?
}

model Membership {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      OrgRole      @default(member)
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

model Scan {
  id           String         @id @default(uuid())
  /// Local filesystem path or git clone URL, depending on sourceType.
  path         String
  sourceType   ScanSourceType @default(local)
  status       ScanStatus     @default(queued)
  overallScore Int?
  verdict      String?
  facts        Json?
  aiNarrative  String?
  progress     String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  /// Owning organization -- the only thing access checks look at. Nullable
  /// because scans created before tenancy had no owner; those stay invisible.
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String?
  /// Who triggered the scan (audit trail only; not used for access).
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  issues         Issue[]
  categoryScores CategoryScore[]
  notifications  Notification[]

  @@index([orgId])
  @@index([userId])
}

model Issue {
  id               String   @id @default(uuid())
  scan             Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId           String
  ruleId           String
  category         String
  severity         Severity
  message          String
  recommendation   String
  estimatedEffort  String

  @@index([scanId])
}

model CategoryScore {
  id       String @id @default(uuid())
  scan     Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId   String
  category String
  score    Int

  @@index([scanId])
  @@unique([scanId, category])
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  /// True when the email came from an OAuth provider that verified it.
  /// Credentials signups never prove ownership, so OAuth logins must not
  /// auto-link to users whose email is unverified.
  emailVerified Boolean @default(false)
  /// bcrypt hash; null for OAuth-only users.
  passwordHash String?
  name         String?
  avatarUrl    String?
  /// Per-user app preferences (notification toggles, ...). Shape is owned by
  /// the API's users controller; null means "all defaults".
  preferences  Json?
  createdAt    DateTime @default(now())

  accounts          Account[]
  resetTokens       PasswordResetToken[]
  notificationReads NotificationRead[]
  scans             Scan[]
  memberships       Membership[]
}

/// The organization's plan. Absence of a row means FREE (no need to backfill
/// one row per org -- see packages/billing's getEffectivePlan()).
model Subscription {
  id    String       @id @default(uuid())
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String       @unique

  plan   PlanTier @default(FREE)
  /// "ACTIVE" | "CANCELLED" | "SUSPENDED" -- mirrors PayPal subscription status.
  status String

  paypalSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  /// True once cancellation is requested; access stays at `plan` until
  /// currentPeriodEnd, then getEffectivePlan() treats the user as FREE.
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A scan-lifecycle (or, later, other) event surfaced in the notification
/// bell. Visible to members of its organization only; read state is tracked
/// per user below.
model Notification {
  id        String        @id @default(uuid())
  type      String
  title     String
  body      String
  /// Nullable only for rows created before tenancy whose scan had no owner;
  /// those are never shown.
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String?
  scan      Scan?         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId    String?
  createdAt DateTime      @default(now())

  reads NotificationRead[]

  @@index([orgId, createdAt])
  @@index([createdAt])
  @@index([scanId])
}

/// Marks a Notification as read by a given user. Absence of a row means unread.
model NotificationRead {
  id             String       @id @default(uuid())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
}

/// Single-use password reset tokens. Only the SHA-256 hash is stored, so a
/// database leak doesn't yield usable reset links.
model PasswordResetToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Links a User to an external OAuth identity (GitHub, Google, ...).
model Account {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}
