generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  queued
  active
  completed
  failed
}

enum ScanSourceType {
  local
  git
}

enum Severity {
  critical
  high
  medium
  low
}

model Scan {
  id           String         @id @default(uuid())
  /// Local filesystem path or git clone URL, depending on sourceType.
  path         String
  sourceType   ScanSourceType @default(local)
  status       ScanStatus     @default(queued)
  overallScore Int?
  verdict      String?
  facts        Json?
  aiNarrative  String?
  progress     String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  issues         Issue[]
  categoryScores CategoryScore[]
}

model Issue {
  id               String   @id @default(uuid())
  scan             Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId           String
  ruleId           String
  category         String
  severity         Severity
  message          String
  recommendation   String
  estimatedEffort  String

  @@index([scanId])
}

model CategoryScore {
  id       String @id @default(uuid())
  scan     Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId   String
  category String
  score    Int

  @@index([scanId])
  @@unique([scanId, category])
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  /// True when the email came from an OAuth provider that verified it.
  /// Credentials signups never prove ownership, so OAuth logins must not
  /// auto-link to users whose email is unverified.
  emailVerified Boolean @default(false)
  /// bcrypt hash; null for OAuth-only users.
  passwordHash String?
  name         String?
  avatarUrl    String?
  /// Per-user app preferences (notification toggles, ...). Shape is owned by
  /// the API's users controller; null means "all defaults".
  preferences  Json?
  createdAt    DateTime @default(now())

  accounts    Account[]
  resetTokens PasswordResetToken[]
}

/// Single-use password reset tokens. Only the SHA-256 hash is stored, so a
/// database leak doesn't yield usable reset links.
model PasswordResetToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Links a User to an external OAuth identity (GitHub, Google, ...).
model Account {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}
