generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  queued
  active
  completed
  failed
}

enum Severity {
  critical
  high
  medium
  low
}

model Scan {
  id          String     @id @default(uuid())
  path        String
  status      ScanStatus @default(queued)
  overallScore Int?
  verdict     String?
  facts       Json?
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  issues         Issue[]
  categoryScores CategoryScore[]
}

model Issue {
  id               String   @id @default(uuid())
  scan             Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId           String
  ruleId           String
  category         String
  severity         Severity
  message          String
  recommendation   String
  estimatedEffort  String

  @@index([scanId])
}

model CategoryScore {
  id       String @id @default(uuid())
  scan     Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId   String
  category String
  score    Int

  @@index([scanId])
  @@unique([scanId, category])
}
